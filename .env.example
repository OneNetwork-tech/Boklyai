# --- Required in production --------------------------------------------------
# Generate with: openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=
# Public URL of the app (used in emails and for the Origin check)
PUBLIC_URL=http://localhost:3000

# --- Database -----------------------------------------------------------------
# Either DATABASE_URL or the POSTGRES_* settings.
# DATABASE_URL=postgres://boklyai:password@localhost:5432/boklyai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=boklyai
POSTGRES_USER=boklyai
# POSTGRES_SSL=true

# --- Server ---------------------------------------------------------------------
PORT=3000
# Number of reverse proxies in front of the app (or their CIDR). Needed for
# correct client IPs (rate limiting, BankID endUserIp).
TRUST_PROXY=loopback
# Served over HTTPS (CSP upgrade-insecure-requests + HSTS); defaults to true in production.
# Set false (with SECURE_COOKIES=false) only to test over plain HTTP on a LAN.
# HTTPS_ONLY=true
# Secure cookies default to on in production; disable only for plain-HTTP testing.
# SECURE_COOKIES=true
SESSION_IDLE_MINUTES=60
SESSION_MAX_HOURS=12
LOGIN_RATE_LIMIT=10

# --- Email (password reset, invitations) -------------------------------------
# Without SMTP_URL, emails are printed to the server log.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=BoklyAI <no-reply@example.com>

# --- Documents / OCR --------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=15
# TESSERACT_PATH=tesseract
# PDFTOTEXT_PATH=pdftotext

# --- BankID (optional) -------------------------------------------------------------
# Requires an RP certificate from your bank. Test environment:
# https://www.bankid.com/en/utvecklare/test
BANKID_ENABLED=false
BANKID_API_URL=https://appapi2.test.bankid.com/rp/v6.0
BANKID_CERT_PATH=
BANKID_KEY_PATH=
BANKID_CA_PATH=
BANKID_PASSPHRASE=

# --- Docker compose only -------------------------------------------------------------
HOST_PORT=3000
