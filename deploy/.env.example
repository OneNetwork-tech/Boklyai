# Server settings for deploy/docker-compose.yml. Copy to .env next to it. Never commit .env.

# Image to run: latest (default branch), a branch name (e.g. claude-charming-noether-lhy664) or sha-<7 chars>
IMAGE_TAG=latest
HOST_PORT=3002

# Required. Generate with: openssl rand -hex 32 / openssl rand -base64 24
SESSION_SECRET=
POSTGRES_PASSWORD=

# The exact address you open in the browser (it is checked against the Origin header),
# e.g. http://192.168.1.20:3002
PUBLIC_URL=http://localhost:3002

# Plain HTTP on a LAN: keep both false. Set true once a TLS reverse proxy is in front.
HTTPS_ONLY=false
SECURE_COOKIES=false
TRUST_PROXY=loopback

# Email (password reset, invitations). Without SMTP_URL, emails are printed to the log.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
MAIL_FROM=BoklyAI <no-reply@example.com>

BANKID_ENABLED=false

# --- Behind an HTTPS reverse proxy on this server (see Caddyfile.example) ---
# Uncomment these, and comment out the matching lines above.
# PUBLIC_URL=https://bokforing.example.se
# HTTPS_ONLY=true
# SECURE_COOKIES=true
# Trust the proxy for client IPs (rate limiting, BankID). Docker networks use
# 172.16.0.0/12 by default (check with: docker network inspect boklyai_default).
# TRUST_PROXY=loopback, 172.16.0.0/12
# Only the proxy can reach the app; plain http://<server-ip>:3002 stops working.
# BIND_ADDRESS=127.0.0.1
